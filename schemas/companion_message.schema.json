{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KLKH7/the-ninety-labs/schemas/companion_message.schema.json",
  "title": "CompanionMessage",
  "description": "One message from the server to the phone companion, told apart by type.",
  "oneOf": [
    { "$ref": "#/$defs/clock" },
    { "$ref": "#/$defs/focus" },
    { "$ref": "#/$defs/answer" },
    { "$ref": "#/$defs/player_card" },
    { "$ref": "#/$defs/flow" }
  ],
  "$defs": {
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "playing"],
      "description": "Where the broadcast is, so the phone stays in step with the video.",
      "properties": {
        "type": { "const": "clock" },
        "t": { "type": "number", "minimum": 0 },
        "playing": { "type": "boolean" }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "player"],
      "description": "The player the phone follows; null for none.",
      "properties": {
        "type": { "const": "focus" },
        "player": { "type": ["string", "null"], "pattern": "^[ha]([1-9]|1[01]|-t[0-9]+)$" }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "answer", "source"],
      "properties": {
        "type": { "const": "answer" },
        "answer": { "$ref": "viewer_answer.schema.json" },
        "source": { "type": "string", "enum": ["code", "model"], "description": "Who wrote the answer: code (it passed the code checks) or the Companion agent (it passed the code checks and the Judge), so the phone can label it honestly." }
      }
    },
    "player_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "player", "t_from", "t_to", "heat", "speed_kmh", "peak_kmh", "distance_m", "source"],
      "description": "A player's stats over t_from..t_to, all computed by code. The player id follows source: a squad id (h7) for ground truth, a team plus track id (h-t12) for tracked positions.",
      "allOf": [
        { "if": { "properties": { "source": { "const": "truth" } }, "required": ["source"] }, "then": { "properties": { "player": { "pattern": "^[ha]([1-9]|1[01])$" } } } },
        { "if": { "properties": { "source": { "const": "tracked" } }, "required": ["source"] }, "then": { "properties": { "player": { "pattern": "^[ha]-t[0-9]+$" } } } }
      ],
      "properties": {
        "type": { "const": "player_card" },
        "player": { "type": "string", "pattern": "^[ha]([1-9]|1[01]|-t[0-9]+)$" },
        "t_from": { "type": "number", "minimum": 0 },
        "t_to": { "type": "number", "minimum": 0 },
        "heat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nx", "ny", "cells"],
          "description": "Share of time in each cell of an nx by ny grid over the pitch, row by row from y = 0, x = 0 first; cells has nx * ny entries.",
          "properties": {
            "nx": { "type": "integer", "minimum": 1 },
            "ny": { "type": "integer", "minimum": 1 },
            "cells": { "type": "array", "items": { "type": "number", "minimum": 0 } }
          }
        },
        "speed_kmh": { "type": "number", "minimum": 0, "description": "Speed at t_to." },
        "peak_kmh": { "type": "number", "minimum": 0 },
        "distance_m": { "type": "number", "minimum": 0 },
        "source": { "type": "string", "enum": ["truth", "tracked"], "description": "Positions from the ground-truth data (before Milestone 1) or from tracking the video." },
        "player_total": {
          "type": "object",
          "additionalProperties": false,
          "required": ["player", "name", "source", "source_label", "running_to_minute", "footage_s", "tracked_s", "footage_coverage", "distance_m", "top_kmh", "withheld"],
          "description": "The match so far of the player the Player ID feed names on this track (ninety/intel/player_stats.py): running over every track the feed names his, to the end of minute running_to_minute and never later. Absent when the feed does not name the track. A figure is null when withheld, its reason in withheld.",
          "properties": {
            "player": { "type": "string" },
            "name": { "type": "string" },
            "source": { "const": "id_feed" },
            "source_label": { "type": "string" },
            "running_to_minute": { "type": "integer", "minimum": 0 },
            "footage_s": { "type": "number", "minimum": 0 },
            "tracked_s": { "type": "number", "minimum": 0 },
            "footage_coverage": { "type": "number", "minimum": 0 },
            "distance_m": { "type": ["number", "null"], "minimum": 0 },
            "top_kmh": { "type": ["number", "null"], "minimum": 0 },
            "withheld": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "team", "t_from", "t_to", "nx", "ny", "vx", "vy", "count", "source"],
      "description": "One team's mean player velocity per cell over t_from..t_to, for the wind map: cells laid out as player_card.heat, each of vx, vy and count with nx * ny entries. A cell nobody crossed has count 0 and null velocity. Computed by code (ninety/intel/window.py, team_flow).",
      "properties": {
        "type": { "const": "flow" },
        "team": { "type": "string", "enum": ["home", "away"] },
        "t_from": { "type": "number", "minimum": 0 },
        "t_to": { "type": "number", "minimum": 0 },
        "nx": { "type": "integer", "minimum": 1 },
        "ny": { "type": "integer", "minimum": 1 },
        "vx": { "type": "array", "items": { "type": ["number", "null"] }, "description": "m/s along x (toward x = 105)." },
        "vy": { "type": "array", "items": { "type": ["number", "null"] }, "description": "m/s along y." },
        "count": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Frame-to-frame steps averaged in the cell." },
        "source": { "type": "string", "enum": ["truth", "tracked"], "description": "Positions from the ground-truth data (before Milestone 1) or from tracking the video." }
      }
    }
  }
}
