# The render job image (ninety/render/job.py): renders training clips in headless Chromium with
# software GL and uploads them to Blob Storage. Run as an Azure Container Apps job by
# infra/render-job.sh, which builds it in the registry with `az acr build`. Same base, platform
# pin and uv.lock as the API image (see Dockerfile).
FROM --platform=linux/amd64 node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --omit=dev

FROM --platform=linux/amd64 ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM --platform=linux/amd64 python:3.12-slim

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_DEV=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-install-project --group render-job
# Chromium and its system libraries, at the version the pinned playwright expects.
RUN uv run --no-sync playwright install --with-deps chromium

COPY ninety ./ninety
RUN uv sync --locked --group render-job
COPY web/render ./web/render
COPY --from=web /web/node_modules ./web/node_modules

ARG NINETY_COMMIT=unknown
ENV NINETY_COMMIT=${NINETY_COMMIT} PATH="/app/.venv/bin:${PATH}"

RUN useradd --uid 10001 --create-home app
USER app

CMD ["python", "-m", "ninety.render.job"]
